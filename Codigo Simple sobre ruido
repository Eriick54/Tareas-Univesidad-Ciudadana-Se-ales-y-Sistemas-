
import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import butter, filtfilt, freqz

# ==================================================
# 1. GENERACIÓN DE LA SEÑAL DE PRUEBA
# ==================================================

fs = 1000
t = np.linspace(0, 1, fs, endpoint=False)

# Señal compuesta
signal = (
    np.sin(2 * np.pi * 50 * t) +
    0.7 * np.sin(2 * np.pi * 150 * t) +
    0.5 * np.sin(2 * np.pi * 300 * t)
)

# Ruido blanco
np.random.seed(42)
noise = 0.5 * np.random.randn(len(t))

# Señal con ruido
signal_noisy = signal + noise

# ==================================================
# 2. DISEÑO DE FILTROS BUTTERWORTH (IIR)
# ==================================================

# Filtro pasa bajos
b_low, a_low = butter(4, 100, btype='low', fs=fs)

# Filtro pasa altos
b_high, a_high = butter(4, 200, btype='high', fs=fs)

# Filtro pasa bandas
b_band, a_band = butter(
    4, [100, 250], btype='band', fs=fs
)

# ==================================================
# 3. APLICAR FILTROS
# ==================================================

signal_low = filtfilt(b_low, a_low, signal_noisy)
signal_high = filtfilt(b_high, a_high, signal_noisy)
signal_band = filtfilt(b_band, a_band, signal_noisy)

# ==================================================
# 4. GRAFICAR SEÑALES
# ==================================================

plt.figure(figsize=(12, 10))

plt.subplot(4, 1, 1)
plt.plot(t, signal_noisy, color='gray')
plt.title("Señal Original con Ruido")
plt.ylabel("Amplitud")
plt.grid()

plt.subplot(4, 1, 2)
plt.plot(t, signal_low, color='blue')
plt.title("Filtro Pasa Bajos (100 Hz)")
plt.ylabel("Amplitud")
plt.grid()

plt.subplot(4, 1, 3)
plt.plot(t, signal_high, color='red')
plt.title("Filtro Pasa Altos (200 Hz)")
plt.ylabel("Amplitud")
plt.grid()

plt.subplot(4, 1, 4)
plt.plot(t, signal_band, color='green')
plt.title("Filtro Pasa Bandas (100 - 250 Hz)")
plt.xlabel("Tiempo (segundos)")
plt.ylabel("Amplitud")
plt.grid()

plt.tight_layout()
plt.show()

# ==================================================
# 5. RESPUESTA EN FRECUENCIA
# ==================================================

plt.figure(figsize=(12, 6))

for b, a, nombre in [
    (b_low, a_low, "Pasa Bajos"),
    (b_high, a_high, "Pasa Altos"),
    (b_band, a_band, "Pasa Bandas")
]:

    w, h = freqz(b, a, worN=8000, fs=fs)

    plt.plot(
        w,
        20 * np.log10(np.maximum(abs(h), 1e-10)),
        label=nombre
    )

plt.title("Respuesta en Frecuencia de los Filtros")
plt.xlabel("Frecuencia (Hz)")
plt.ylabel("Ganancia (dB)")
plt.legend()
plt.grid()
plt.ylim(-80, 5)
plt.show()

print("Proceso de filtrado terminado correctamente.")
